{
  "name": "tide-machine",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev --port 4360",
    "build": "astro build && node scripts/headers.mjs",
    "preview": "astro preview --port 4361",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "globals": "node scripts/print-globals.ts",
    "stills": "node scripts/make-stills.ts",
    "deploy": "pnpm build && wrangler deploy",
    "preview:worker": "pnpm build && wrangler dev --port 8794"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.4.2",
    "lenis": "1.3.27",
    "nanostores": "1.5.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sass": "1.106.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
