---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Renderer from '../render/Renderer.astro';
import Narration, { type NarrationCaption } from '../story/Narration.astro';
import Hud from '../hud/Hud.astro';
import { STAGES as CHAPTERS, STAGE_STARTS as CHAPTER_STARTS } from '../time/stages.ts';
import { VH_PER_WEIGHT } from '../scroll/driver.ts';
import { HERO_END, MIN_DWELL_SVH, captionSchedule } from '../story/schedule.ts';
import { STATUS_HELP, STATUS_LABEL, CREDITS, SITE } from '../data/site.ts';
import { supHtml } from '../lib/sup.ts';
import experiments from '../../public/data/experiments.json';
import positions from '../../public/data/positions.json';

const entries = await getCollection('stages');
const byId = new Map(entries.map((e) => [e.data.id, e]));
const chapters = await Promise.all(
  CHAPTERS.map(async (c, i) => {
    const entry = byId.get(c.id);
    const rendered = entry ? await render(entry) : null;
    return {
      c,
      i,
      p0: CHAPTER_STARTS[i]!,
      p1: CHAPTER_STARTS[i + 1]!,
      data: entry?.data ?? {
        id: c.id,
        title: c.id,
        kicker: '',
        summary: '',
        beats: [],
        howWeKnow: '',
        sources: [],
      },
      Content: rendered?.Content ?? null,
    };
  }),
);
const totalWeight = CHAPTERS.reduce((s, c) => s + c.scrollWeight, 0);
const totalSvh = totalWeight * VH_PER_WEIGHT;

// One caption at a time: each chapter's intro card, then its beats (src/story/schedule.ts).
const schedule = captionSchedule(
  chapters.map(({ p0, p1, data }) => ({ p0, p1, beats: data.beats.map((b) => b.local) })),
  { heroEnd: HERO_END, minDwell: MIN_DWELL_SVH / totalSvh },
);
const captions: NarrationCaption[] = schedule.map(({ chapter, beat, start }) => {
  const d = chapters[chapter]!.data;
  if (beat < 0) return { chapter, start, kind: 'intro', kicker: d.kicker, title: d.title, text: d.summary };
  const b = d.beats[beat]!;
  return { chapter, start, kind: 'beat', time: b.time, text: b.text };
});
/** Keyboard stops land just inside each caption's window. */
const stopOf = (chapter: number, beat: number) =>
  schedule.find((c) => c.chapter === chapter && c.beat === beat)!.start + 0.25 * (MIN_DWELL_SVH / totalSvh);
const titles = chapters.map((ch) => ch.data.title);
---

<Base>
  <Renderer />
  <Narration captions={captions} titles={titles} />
  <Hud />

  <header class="hero" data-hero>
    <p class="hero-kicker">
      <span>{CHAPTERS.length} stages</span><span>Relativity</span><span>Philosophy of time</span>
    </p>
    <h1>{SITE.name}</h1>
    <p class="hero-lede">
      Is the future already there? Relativity says there is no single “now”. Scroll, and we’ll build the argument that
      past, present and future all exist, one tested step at a time, then ask whether it holds.
    </p>
    <p class="hero-hint" aria-hidden="true"><span></span>Scroll to begin</p>
    <p class="hero-keys">
      Or page through it: <kbd>↓</kbd> <kbd>PgDn</kbd> <kbd>Space</kbd> next · <kbd>↑</kbd> <kbd>PgUp</kbd> back · <kbd>Home</kbd>
      <kbd>End</kbd> start / end
    </p>
  </header>

  <main id="story" class="story" data-story style={`height: calc(${totalSvh}svh + 100svh)`}>
    {
      chapters.map(({ c, i, p0, data }) => (
        <section
          id={c.id}
          class="chapter"
          data-chapter={c.id}
          aria-labelledby={`h-${c.id}`}
          style={`top: ${(p0 * totalSvh).toFixed(3)}svh; height: ${(c.scrollWeight * VH_PER_WEIGHT).toFixed(3)}svh`}
        >
          <p class="kicker" set:html={supHtml(`Stage ${i + 1} · ${data.kicker}`)} />
          <h2 id={`h-${c.id}`}>{data.title}</h2>
          {data.summary && <p set:html={supHtml(data.summary)} />}
          {data.beats.map((b, k) => (
            <p data-beat-progress={stopOf(i, k)}>
              {b.time && <span set:html={supHtml(`${b.time}: `)} />}
              <Fragment set:html={supHtml(b.text)} />
            </p>
          ))}
        </section>
      ))
    }
  </main>

  <footer class="credits" id="credits" aria-labelledby="credits-h">
    <div class="credits-inner">
      <h2 id="credits-h">About this explanation</h2>
      <p class="lede">
        Every tilt, tick and offset on screen is computed in your browser from relativity. Where we exaggerate a speed, a
        distance or a rate to make it visible, the stage says so, and the numbers in the corner are always the real ones.
      </p>
      <h3>Stage by stage: the longer story and how we know</h3>
      <div class="stages">
        {
          chapters.map(({ i, data, Content }) => (
            <details class="stage">
              <summary>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">{data.title}</span>
                <span class="k" set:html={supHtml(data.kicker)} />
              </summary>
              {Content && (
                <div class="body">
                  <Content />
                </div>
              )}
              {data.howWeKnow && (
                <>
                  <h4>How we know</h4>
                  <p set:html={supHtml(data.howWeKnow)} />
                </>
              )}
              {data.sources.length > 0 && (
                <ul>
                  {data.sources.map((src) => (
                    <li>
                      <a href={src.url} rel="noopener" target="_blank">
                        {src.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </details>
          ))
        }
      </div>
      <h3>What has been measured</h3>
      <ul class="evidence">
        {
          [...experiments]
            .sort((a, b) => a.year - b.year)
            .map((e) => (
              <li>
                <p class="ev-head">
                  <span class="ev-year">{e.year}</span>
                  <span class="ev-name">{e.name}</span>
                </p>
                <p class="ev-tested">{e.tested}</p>
                <p class="ev-result" set:html={supHtml(e.result)} />
                <p class="ev-src">
                  {e.sources.map((s, k) => (
                    <>
                      {k > 0 && ' · '}
                      <a href={s.url} rel="noopener" target="_blank">
                        {s.label}
                      </a>
                    </>
                  ))}
                </p>
              </li>
            ))
        }
      </ul>
      <h3>Who argued what</h3>
      <ul class="evidence positions">
        {positions.map((p) => (
          <li data-camp={p.camp}>
            <p class="ev-head">
              <span class="ev-year">{p.year}</span>
              <span class="ev-name">{p.who}</span>
            </p>
            <p class="ev-tested">{p.claim}</p>
            <p class="ev-src">
              {p.sources.map((s) => (
                <a href={s.url} rel="noopener" target="_blank">
                  {s.label}
                </a>
              ))}
            </p>
          </li>
        ))}
      </ul>
      <h3>How sure are we?</h3>
      <dl class="acc">
        {(Object.keys(STATUS_LABEL) as (keyof typeof STATUS_LABEL)[]).map((k) => (
          <div data-st={k}>
            <dt>{STATUS_LABEL[k]}</dt>
            <dd>{STATUS_HELP[k]}</dd>
          </div>
        ))}
      </dl>
      <h3>Credits and data</h3>
      <ul class="credit-list">
        {CREDITS.map((c) => (
          <li>
            <b>{c.label}.</b> {c.text}
            {c.url && (
              <>
                {' '}
                <a href={c.url} rel="noopener" target="_blank">
                  Source
                </a>
              </>
            )}
          </li>
        ))}
      </ul>
      <p class="fine">
        Keyboard: ↑ ↓ / Page Up / Page Down step through the story one caption at a time; Home and End jump to the start and the
        end. Rendering quality adapts to your device automatically. A companion piece, <a href={SITE.cosmicHistory}>Cosmic History</a>,
        follows the universe from the Big Bang to today.
      </p>
    </div>
  </footer>

  <noscript>
    <p class="noscript">This explanation draws spacetime with WebGPU or WebGL and needs JavaScript. The story text above still reads in order.</p>
  </noscript>
</Base>

<script>
  import { createScrollDriver } from '../scroll/driver.ts';
  import { $progress } from '../state/store.ts';
  import { HERO_END } from '../story/schedule.ts';

  document.documentElement.classList.add('js');
  // ?clean=1 hides all HTML overlays (stills / OG capture); ?clean=hero keeps the title card.
  const clean = new URLSearchParams(location.search).get('clean');
  if (clean) document.documentElement.classList.add('clean', `clean-${clean}`);
  const driver = createScrollDriver(document.querySelector<HTMLElement>('[data-story]')!);
  (window as unknown as { __driver?: unknown }).__driver = driver;

  // Past "now" the credits scroll in: fade the narration and HUD out over the first ~half viewport.
  const story = document.querySelector<HTMLElement>('[data-story]')!;
  const root = document.documentElement;
  let endFade = -1;
  const onScroll = () => {
    const end = story.offsetTop + story.offsetHeight - window.innerHeight;
    const f = Math.min(1, Math.max(0, (window.scrollY - end) / (window.innerHeight * 0.45)));
    if (f === endFade) return;
    endFade = f;
    root.style.setProperty('--end-fade', f.toFixed(3));
    root.classList.toggle('past-end', f >= 1);
  };
  driver.lenis.on('scroll', onScroll);
  window.addEventListener('resize', onScroll);
  onScroll();

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  $progress.subscribe((p) => {
    const o = Math.max(0, 1 - p / HERO_END);
    hero.style.opacity = String(o);
    hero.style.visibility = o === 0 ? 'hidden' : 'visible';
  });
</script>

<style>
  :global(.narration),
  :global(.hud),
  :global(.labels) {
    opacity: calc(1 - var(--end-fade, 0));
  }
  :global(html.past-end .narration),
  :global(html.past-end .hud),
  :global(html.past-end .labels) {
    visibility: hidden;
  }
  :global(html.clean .narration),
  :global(html.clean .labels),
  :global(html.clean .hud),
  :global(html.clean-1 .hero) {
    display: none !important;
  }
  /* The story keeps its height (it defines the scroll length); only its text is hidden. */
  :global(html.clean .story),
  :global(html.clean .credits) {
    visibility: hidden !important;
  }
  /* Share image: title card only, no scroll or keyboard hints. */
  :global(html.clean .hero-hint),
  :global(html.clean .hero-keys) {
    display: none !important;
  }
  :global(html.clean .cosmos .veil) {
    display: none;
  }
  .hero {
    position: fixed;
    z-index: 10;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 max(1.5rem, 7vw);
    max-width: 52rem;
    pointer-events: none;
  }
  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-glow);
  }
  .hero-kicker span:not(:last-child)::after {
    content: '·';
    margin: 0 0.8em;
    color: var(--color-mute);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-paper);
    margin-top: 0.6rem;
    text-shadow: 0 0 40px rgb(0 0 0 / 0.6);
  }
  .hero-lede {
    margin-top: 1.4rem;
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-fog);
  }
  .hero-hint {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .hero-hint span {
    width: 1px;
    height: 2.6rem;
    background: linear-gradient(var(--color-paper), transparent);
    animation: drip 2.4s var(--ease-cosmic) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    70% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* Paging directions: desktop only (a fine pointer with hover and room for them). */
  .hero-keys {
    display: none;
    position: absolute;
    left: max(1.5rem, 7vw);
    bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--color-mute);
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .hero-keys {
      display: block;
    }
  }
  .hero-keys kbd {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    margin: 0 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-fog);
    border: 1px solid var(--color-line-strong);
    border-radius: 0.3rem;
    background: rgb(255 255 255 / 0.03);
  }
  .story {
    position: relative;
    z-index: 5;
  }
  .chapter {
    position: absolute;
    left: 0;
    right: 0;
    padding: 30svh max(1.5rem, 6vw) 0;
    max-width: 40rem;
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  /* With JS the narration layer shows this text one caption at a time; keep it for screen readers only. */
  :global(html.js) .chapter > * {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .credits a {
    color: var(--color-signal);
    text-decoration: underline;
    text-decoration-color: rgb(143 208 255 / 0.4);
    text-underline-offset: 2px;
  }
  .credits {
    position: relative;
    z-index: 5;
    background: linear-gradient(rgb(2 2 5 / 0), rgb(2 2 5 / 0.92) 12rem, var(--color-void));
    padding: 16rem max(1.5rem, 6vw) 6rem;
  }
  .credits-inner {
    max-width: 44rem;
  }
  .credits h2 {
    font-family: var(--font-serif);
    font-weight: 350;
    font-size: 2.4rem;
    color: var(--color-paper);
  }
  .credits h3 {
    margin-top: 2.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-glow);
  }
  .lede {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .acc {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.6rem;
  }
  .acc div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.8rem;
  }
  .acc dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--st);
  }
  .evidence {
    margin-top: 0.9rem;
    display: grid;
    gap: 1.1rem;
    border-left: 1px solid var(--color-line);
    padding-left: 1.1rem;
  }
  .ev-head {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
  }
  .ev-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-glow);
  }
  .ev-name {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    color: var(--color-paper);
  }
  .ev-tested {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .ev-result {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-st-measured);
  }
  .ev-src {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .positions [data-camp='block'] .ev-year {
    color: var(--color-st-argument);
  }
  .positions [data-camp='growing'] .ev-year,
  .positions [data-camp='presentism'] .ev-year {
    color: var(--color-st-open);
  }
  .positions [data-camp='neutral'] .ev-year {
    color: var(--color-st-established);
  }
  .credit-list {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.8rem;
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .credit-list b {
    color: var(--color-paper);
    font-weight: 500;
  }
  .fine {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    color: var(--color-mute);
  }
  .noscript {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 50;
    padding: 0.8rem 1rem;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
  }
  .stages {
    margin-top: 0.9rem;
    border-top: 1px solid var(--color-line);
  }
  .stage {
    border-bottom: 1px solid var(--color-line);
  }
  .stage summary {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.85rem 0;
    cursor: pointer;
    list-style: none;
  }
  .stage summary::-webkit-details-marker {
    display: none;
  }
  .stage .n,
  .stage .k {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--color-mute);
  }
  .stage .t {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-paper);
  }
  .stage summary:hover .t {
    color: var(--color-glow);
  }
  .stage[open] .t {
    color: var(--color-glow);
  }
  .stage .body,
  .stage > p,
  .stage h4,
  .stage ul {
    margin-left: 3rem;
  }
  .stage .body {
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .stage .body :global(p + p) {
    margin-top: 0.7rem;
  }
  .stage h4 {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-signal);
  }
  .stage > p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .stage ul {
    margin-top: 0.7rem;
    margin-bottom: 1.2rem;
    display: grid;
    gap: 0.25rem;
    font-size: 0.8rem;
  }
  @media (max-width: 767px) {
    .hero {
      padding-top: 4rem;
    }
    .stage summary {
      grid-template-columns: 1.8rem 1fr;
    }
    .stage .k {
      display: none;
    }
    .stage .body,
    .stage > p,
    .stage h4,
    .stage ul {
      margin-left: 0;
    }
  }
</style>
