---
// The Moon pulls unevenly (stage 2): San Francisco's equilibrium tide through one lunar day as Earth turns under the
// two bulges. The curve is sfHeight() from src/script/moon.ts (the same function that places the marker in the
// scene); the dot is the scene's clock. Two highs, two lows, 24 h 50 min.
import { LUNAR_DAY_H } from '../../script/moon.ts';
const end = `${Math.floor(LUNAR_DAY_H)} h ${Math.floor((LUNAR_DAY_H % 1) * 60)} min`;
---

<section class="card moon" data-card="moon">
  <h3>
    San Francisco <span>Newton’s tide · one lunar day</span>
  </h3>
  <svg viewBox="0 0 320 112" data-moon-svg>
    <g class="grid" data-grid></g>
    <path class="curve" data-curve></path>
    <path class="done" data-done></path>
    <circle class="head" r="3.2" data-head></circle>
    <text class="t0" x="14" y="110">
      0 h
    </text>
    <text class="t1" x="306" y="110">
      {end}
    </text>
  </svg>
  <p class="legend">
    <span data-hl>two highs, two lows</span>
  </p>
</section>

<script>
  import { LUNAR_DAY_H, moonState, sfHeight, TURN_START_H } from '../../script/moon.ts';
  import { onStage, showCard } from '../card.ts';

  const NS = 'http://www.w3.org/2000/svg';
  const card = document.querySelector<HTMLElement>('[data-card="moon"]')!;
  const svg = card.querySelector<SVGSVGElement>('[data-moon-svg]')!;
  const curve = svg.querySelector<SVGPathElement>('[data-curve]')!;
  const done = svg.querySelector<SVGPathElement>('[data-done]')!;
  const head = svg.querySelector<SVGCircleElement>('[data-head]')!;
  const grid = svg.querySelector<SVGGElement>('[data-grid]')!;

  const X = (h: number) => 14 + (292 * h) / LUNAR_DAY_H;
  const Y = (m: number) => 50 - m * 230;
  for (const m of [0.15, 0, -0.15]) {
    const l = document.createElementNS(NS, 'line');
    l.setAttribute('x1', '14');
    l.setAttribute('x2', '306');
    l.setAttribute('y1', Y(m).toFixed(1));
    l.setAttribute('y2', Y(m).toFixed(1));
    if (m === 0) l.setAttribute('class', 'zero');
    grid.appendChild(l);
    const t = document.createElementNS(NS, 'text');
    t.setAttribute('x', '10');
    t.setAttribute('y', (Y(m) + 2.5).toFixed(1));
    t.textContent = m === 0 ? '0' : `${m > 0 ? '+' : '−'}${Math.abs(m).toFixed(2)} m`;
    grid.appendChild(t);
  }
  const N = 240;
  const pts: string[] = [];
  for (let i = 0; i <= N; i++) {
    const h = (LUNAR_DAY_H * i) / N;
    pts.push(`${i ? 'L' : 'M'}${X(h).toFixed(1)},${Y(sfHeight(TURN_START_H + h)).toFixed(1)}`);
  }
  curve.setAttribute('d', pts.join(''));

  let last = -1;
  onStage((s) => {
    const on = s.stageId === 'moon';
    const st = moonState(on ? s.local : 0);
    showCard(card, on && st.sf > 0.6 && st.pullBack < 0.5);
    if (!on) return;
    const h = Math.min(LUNAR_DAY_H, Math.max(0, st.hours - TURN_START_H));
    if (Math.abs(h - last) < 0.02) return;
    last = h;
    const k = Math.round((h / LUNAR_DAY_H) * N);
    done.setAttribute('d', pts.slice(0, Math.max(1, k + 1)).join(''));
    head.setAttribute('cx', X(h).toFixed(1));
    head.setAttribute('cy', Y(sfHeight(TURN_START_H + h)).toFixed(1));
  });
</script>

<style>
  svg {
    display: block;
    width: 100%;
    margin-top: 0.55rem;
    overflow: visible;
  }
  .grid :global(line) {
    stroke: rgb(255 255 255 / 0.08);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .grid :global(line.zero) {
    stroke: rgb(255 255 255 / 0.16);
    stroke-dasharray: none;
  }
  .grid :global(text),
  .t0,
  .t1 {
    font-family: var(--font-mono);
    font-size: 7.5px;
    fill: var(--color-mute);
  }
  .grid :global(text) {
    text-anchor: end;
  }
  .t0 {
    text-anchor: start;
  }
  .t1 {
    text-anchor: end;
  }
  .curve {
    fill: none;
    stroke: rgb(143 208 255 / 0.25);
    stroke-width: 1;
  }
  .done {
    fill: none;
    stroke: var(--color-obs-a);
    stroke-width: 1.5;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 3px rgb(255 160 74 / 0.6));
  }
  .head {
    fill: #ffe2c2;
    filter: drop-shadow(0 0 4px rgb(255 170 90 / 0.9));
  }
  .legend {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }
</style>
