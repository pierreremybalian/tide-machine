---
// When the sea disagrees (stage 12): the Battery, 28–31 October 2012. The machine's prediction (brass, computed
// from NOAA's constants) against what the gauge measured (cyan, once revealed), the gap between them shaded: the
// storm surge. A cursor follows the stage's clock (src/script/sandy.ts).
import { PEAK, eastern } from '../../script/sandy.ts';
const peak = eastern(PEAK.ms);
---

<section class="card sandy" data-card="sandy">
  <h3>The Battery, New York <span>Oct 28–30, 2012</span></h3>
  <svg viewBox="0 0 320 120" data-svg>
    <g class="grid" data-grid></g>
    <path class="gap" data-gap></path>
    <path class="pred" data-pred></path>
    <path class="obs" data-obs></path>
    <line class="cursor" y1="2" y2="112" data-cursor></line>
    <circle class="head" r="2.6" data-head></circle>
  </svg>
  <p class="legend">
    <span><i class="l-pred"></i>predicted from the Moon and Sun</span>
    <span data-obs-legend><i class="l-obs"></i>measured</span>
  </p>
  <p class="peak" data-peak>
    Peak {peak.time} on {peak.day}: <b class="o">{PEAK.observed.toFixed(2)} m</b> measured, <b class="p">{PEAK.predicted.toFixed(2)} m</b> predicted. The difference, <b class="s">{PEAK.surge.toFixed(2)} m</b>, was the storm.
  </p>
</section>

<script>
  import { OBS_END, OBS_START, observedAt, predictedAt, sandyState } from '../../script/sandy.ts';
  import { onStage, showCard } from '../card.ts';

  const NS = 'http://www.w3.org/2000/svg';
  const card = document.querySelector<HTMLElement>('[data-card="sandy"]')!;
  const svg = card.querySelector<SVGSVGElement>('[data-svg]')!;
  const obs = svg.querySelector<SVGPathElement>('[data-obs]')!;
  const gap = svg.querySelector<SVGPathElement>('[data-gap]')!;
  const cursor = svg.querySelector<SVGLineElement>('[data-cursor]')!;
  const head = svg.querySelector<SVGCircleElement>('[data-head]')!;
  const peakEl = card.querySelector<HTMLElement>('[data-peak]')!;
  const obsLegend = card.querySelector<HTMLElement>('[data-obs-legend]')!;
  const SPAN_H = (OBS_END - OBS_START) / 3600e3;
  const lo = -0.3;
  const hi = 4.6;
  const X = (h: number) => 2 + (300 * h) / SPAN_H;
  const Y = (m: number) => 4 + (106 * (hi - m)) / (hi - lo);
  const STEP = 0.2;
  const P: number[] = [];
  const O: number[] = [];
  for (let h = 0; h <= SPAN_H + 1e-9; h += STEP) {
    P.push(predictedAt(OBS_START + h * 3600e3));
    O.push(observedAt(OBS_START + h * 3600e3));
  }
  let pd = '';
  P.forEach((v, i) => (pd += `${i ? 'L' : 'M'}${X(i * STEP).toFixed(1)},${Y(v).toFixed(1)}`));
  svg.querySelector<SVGPathElement>('[data-pred]')!.setAttribute('d', pd);
  const grid = svg.querySelector<SVGGElement>('[data-grid]')!;
  for (let h = 0; h <= SPAN_H; h += 24) {
    const l = document.createElementNS(NS, 'line');
    l.setAttribute('x1', X(h).toFixed(1));
    l.setAttribute('x2', X(h).toFixed(1));
    l.setAttribute('y1', '2');
    l.setAttribute('y2', '112');
    grid.appendChild(l);
  }
  for (const m of [0, 1, 2, 3, 4]) {
    const l = document.createElementNS(NS, 'line');
    l.setAttribute('class', 'h');
    l.setAttribute('x1', '0');
    l.setAttribute('x2', '304');
    l.setAttribute('y1', Y(m).toFixed(1));
    l.setAttribute('y2', Y(m).toFixed(1));
    grid.appendChild(l);
    const t = document.createElementNS(NS, 'text');
    t.setAttribute('x', '318');
    t.setAttribute('y', (Y(m) + 2.5).toFixed(1));
    t.textContent = `${m} m`;
    grid.appendChild(t);
  }

  let last = '';
  onStage((s) => {
    const on = s.stageId === 'sandy';
    const st = sandyState(on ? s.local : 0);
    showCard(card, on && st.card > 0.5);
    if (!on) return;
    const hNow = Math.max(0, Math.min(SPAN_H, (st.ms - OBS_START) / 3600e3));
    const key = `${hNow.toFixed(2)}|${st.real.toFixed(2)}`;
    if (key === last) return;
    last = key;
    const x = X(hNow).toFixed(1);
    cursor.setAttribute('x1', x);
    cursor.setAttribute('x2', x);
    // The measured curve and the gap, drawn up to the clock once the real water is shown.
    const n = Math.floor(hNow / STEP);
    let od = '';
    let top = '';
    let bot = '';
    for (let i = 0; i <= n; i++) {
      const px = X(i * STEP).toFixed(1);
      od += `${i ? 'L' : 'M'}${px},${Y(O[i]!).toFixed(1)}`;
      top += `${i ? 'L' : 'M'}${px},${Y(O[i]!).toFixed(1)}`;
      bot = `L${px},${Y(P[i]!).toFixed(1)}` + bot;
    }
    obs.setAttribute('d', od);
    gap.setAttribute('d', n > 0 ? `${top}${bot}Z` : '');
    card.style.setProperty('--real', st.real.toFixed(3));
    const yNow = st.predicted + st.real * st.surge;
    head.setAttribute('cx', x);
    head.setAttribute('cy', Y(yNow).toFixed(1));
    obsLegend.style.opacity = st.real.toFixed(3);
    peakEl.style.opacity = s.local >= 0.56 ? '1' : '0';
  });
</script>

<style>
  svg {
    display: block;
    width: 100%;
    margin-top: 0.55rem;
    overflow: visible;
  }
  .grid :global(line) {
    stroke: rgb(255 255 255 / 0.06);
  }
  .grid :global(line.h) {
    stroke: rgb(255 255 255 / 0.1);
    stroke-dasharray: 2 3;
  }
  .grid :global(text) {
    font-family: var(--font-mono);
    font-size: 7.5px;
    text-anchor: end;
    fill: var(--color-mute);
  }
  .pred {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 1.3;
    filter: drop-shadow(0 0 3px rgb(230 184 102 / 0.5));
  }
  .obs {
    fill: none;
    stroke: var(--color-obs-b);
    stroke-width: 1.4;
    opacity: var(--real, 0);
    filter: drop-shadow(0 0 3px rgb(82 203 255 / 0.6));
  }
  .gap {
    fill: rgb(255 160 74 / 0.22);
    opacity: var(--real, 0);
  }
  .cursor {
    stroke: rgb(255 255 255 / 0.45);
  }
  .head {
    fill: #fff;
    filter: drop-shadow(0 0 4px rgb(255 255 255 / 0.8));
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-mute);
  }
  .legend i {
    display: inline-block;
    width: 0.8rem;
    height: 2px;
    margin-right: 0.35rem;
    vertical-align: middle;
  }
  .l-pred {
    background: var(--color-brass);
  }
  .l-obs {
    background: var(--color-obs-b);
  }
  .peak {
    margin-top: 0.5rem;
    font-size: 0.7rem;
    line-height: 1.45;
    color: var(--color-fog);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .peak b {
    font-weight: 500;
  }
  .peak .o {
    color: var(--color-obs-b);
  }
  .peak .p {
    color: var(--color-brass);
  }
  .peak .s {
    color: var(--color-obs-a);
  }
</style>
